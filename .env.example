# =============================================================================
# AuthG — Environment Configuration Template (.env.example)
# Copy to .env and fill in values if automating release signing.
# NOTE: AuthG operates 100% offline and requires ZERO runtime secrets!
# =============================================================================

# Optional: Tauri Updater / Release Signing Private Key
# TAURI_SIGNING_PRIVATE_KEY=""
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Optional: macOS Apple Developer Code Signing & Notarization
# APPLE_CERTIFICATE=""
# APPLE_CERTIFICATE_PASSWORD=""
# APPLE_SIGNING_IDENTITY=""
# APPLE_ID=""
# APPLE_PASSWORD=""
# APPLE_TEAM_ID=""
